{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run skills:sync)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(curl -s localhost:8787/api/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)"
    ]
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": { "source": "github", "repo": "pbakaus/impeccable" }
    },
    "taste-skill": {
      "source": { "source": "github", "repo": "Leonxlnx/taste-skill" }
    }
  },
  "enabledPlugins": {
    "impeccable@impeccable": true,
    "taste-skill@taste-skill": true
  }
}
