MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai_workspace_os
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
TOKEN_SECRET=<64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
APP_URL=http://localhost:5173
API_PORT=8787
# Gemini (email analysis + agent). Key from https://aistudio.google.com/apikey. Use a billing-enabled key for real inboxes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded, rate-limited or too slow. "none" disables it.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: how much Gmail to import (full format, paced under Gmail's quota).
GMAIL_LOOKBACK_DAYS=30
GMAIL_MAX_MESSAGES=300

# Sales dashboard: your local Postgres. The database is created on first "Load demo data" if it does not exist.
# Format: postgres://USER:PASSWORD@localhost:5432/ai_workspace_sales
POSTGRES_URL=

# Time zone for the email schedule's working hours and for reading dates in emails (the browser's zone is used when known).
TIME_ZONE=Asia/Beirut

# Meeting requests (decision #55): set to dry-run to record the automatic availability replies without sending them
# (use it on test databases and demos). Leave empty to send. Sample data never sends.
MEETING_EMAILS=

# How often the server checks Gmail for new mail (seconds, at least 20). A sync runs only when something changed.
GMAIL_POLL_SECONDS=60

# Telegram (decision #64): api_id and api_hash from https://my.telegram.org (API development tools). The user signs in
# with their own phone number on the Integrations page; the app keeps only an encrypted session. Read-only.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Production (decision #63). NODE_ENV=production makes a missing MONGODB_URI, TOKEN_SECRET or public APP_URL stop the
# server at start. Behind a hosting proxy set TRUST_PROXY=true so https and client addresses are read correctly.
# The host's PORT is used when API_PORT is empty and NODE_ENV=production.
NODE_ENV=
TRUST_PROXY=
